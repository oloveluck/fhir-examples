{"resourceType":"ViewDefinition","name":"fhir_obs_other","status":"active","resource":"Observation",
"where":[{"path":"meta.profile.first().matches('(datetimeevents|outputevents|vital-signs|-ed|micro-test|micro-org|micro-susc)$')"}],
"select":[{"column":[{"name":"id","path":"getResourceKey()"},
{"name":"profile","path":"meta.profile.first().substring(58)"},
{"name":"patient_id","path":"subject.getReferenceKey(Patient)"},
{"name":"encounter_id","path":"encounter.getReferenceKey(Encounter)"},
{"name":"specimen_id","path":"specimen.getReferenceKey(Specimen)"},
{"name":"derived_id","path":"derivedFrom.first().getReferenceKey(Observation)"},
{"name":"code_system","path":"code.coding.system.first()"},
{"name":"code","path":"code.coding.code.first()"},
{"name":"display","path":"code.coding.display.first()"},
{"name":"charttime","path":"effective.ofType(dateTime).toString().substring(0,19).replace('T',' ')"},
{"name":"valuenum","path":"value.ofType(Quantity).value"},
{"name":"valuestr","path":"value.ofType(string)"},
{"name":"valuecc","path":"value.ofType(CodeableConcept).coding.code.first()"}]}]}
