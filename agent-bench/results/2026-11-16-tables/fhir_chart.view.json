{"resourceType":"ViewDefinition","name":"fhir_chart","status":"active","resource":"Observation",
"where":[{"path":"meta.profile.first().endsWith('observation-chartevents')"}],
"select":[{"column":[{"name":"id","path":"getResourceKey()"},
{"name":"encounter_id","path":"encounter.getReferenceKey(Encounter)"},
{"name":"itemid","path":"code.coding.code.first()"},
{"name":"label","path":"code.coding.display.first()"},
{"name":"charttime","path":"effective.ofType(dateTime).toString().substring(0,19).replace('T',' ')"},
{"name":"valuenum","path":"value.ofType(Quantity).value"}]}]}
